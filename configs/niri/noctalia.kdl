layout {

    focus-ring {
        active-color   "#b4c8e8"
        inactive-color "#121315"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b4c8e8"
        inactive-color "#121315"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#b4c8e8"
        inactive-color "#536682"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b4c8e880"
    }
}

recent-windows {
    highlight {
        active-color "#b4c8e8"
        urgent-color "#ffb4ab"
    }
}
