{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "~/.config/fastfetch/arch.txt",
        "padding": {
            "top": 1
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        "break",
        "break",

        {
            "type": "os",
            "key": "  󰍹 OS",
            "keyColor": "33"
        },

        {
            "type": "kernel",
            "key": "  󰌽 Kernel",
            "keyColor": "33"
        },

        {
            "type": "host",
            "key": "  󰌢 Machine",
            "keyColor": "33"
        },

        {
            "type": "packages",
            "key": "  󰏖 Packages",
            "keyColor": "33"
        },

        {
            "type": "cpu",
            "key": "  󰻠 CPU",
            "keyColor": "33"
        },

        {
            "type": "memory",
            "key": "  󰑭 Memory",
            "keyColor": "33"
        },

        {
            "type": "command",
            "key": "   age",
            "keyColor": "35",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },

        "break",

        // -- Colors Block --
        {
          "type": "colors",
          "symbol": "circle"
        },

        "break"
    ]
}
